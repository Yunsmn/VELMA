<mujoco model="challenge_scene">
    <include file="so101_new_calib.xml" />

    <option timestep="0.002" gravity="0 0 -9.81" noslip_iterations="3" impratio="10" cone="elliptic"/>

    <default>
        <geom solref="0.001 1" solimp="0.99 0.99 0.001"/>
    </default>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="90" elevation="-20" />
        <map znear="0.005" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
        <material name="cube_material"      rgba="0.9 0.1 0.1 1" />   <!-- red -->
        <material name="block_material"     rgba="0.1 0.3 0.9 1" />   <!-- blue -->
        <material name="small_material"     rgba="0.1 0.8 0.2 1" />   <!-- green -->
        <material name="cyl_material"       rgba="0.9 0.8 0.1 1" />   <!-- yellow -->
        <material name="ball_material"      rgba="0.6 0.2 0.8 1" />   <!-- purple -->
        <material name="wall_material"      rgba="0.5 0.5 0.5 1" />   <!-- grey obstacle -->
        <material name="container_material" rgba="0.2 0.2 0.8 0.8" /> <!-- blue bin -->
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- ── Objects on the table (each a free body the registry finds) ──
             Mix of graspable boxes (cube-scale, flat faces) and round decoys the flat
             pads can't hold. Names/colors are arbitrary — the agent must reason, not
             rely on any fixed identity. -->

        <!-- red box, 30mm -->
        <body name="cube" pos="0.19 -0.10 0.015">
            <freejoint name="cube_joint"/>
            <geom name="cube_geom" type="box" size="0.015 0.015 0.015" mass="0.03" material="cube_material" friction="0.5 0.05 0.001"/>
            <site name="cube_center" pos="0 0 0" size="0.005"/>
        </body>

        <!-- blue box, 30mm -->
        <body name="box_blue" pos="0.26 -0.07 0.015">
            <freejoint name="box_blue_joint"/>
            <geom name="box_blue_geom" type="box" size="0.015 0.015 0.015" mass="0.03" material="block_material" friction="0.5 0.05 0.001"/>
        </body>

        <!-- green box, 32mm -->
        <body name="box_green" pos="0.20 -0.04 0.015">
            <freejoint name="box_green_joint"/>
            <geom name="box_green_geom" type="box" size="0.015 0.015 0.015" mass="0.03" material="small_material" friction="0.5 0.05 0.001"/>
        </body>

        <!-- yellow cylinder, 30mm diameter x 50mm tall (round -> hard for flat pads) -->
        <body name="cyl" pos="0.27 0.03 0.025">
            <freejoint name="cyl_joint"/>
            <geom name="cyl_geom" type="cylinder" size="0.015 0.025" mass="0.035" material="cyl_material" friction="0.5 0.05 0.001"/>
        </body>

        <!-- purple sphere, 30mm (round -> hard for flat pads) -->
        <body name="ball" pos="0.27 -0.13 0.015">
            <freejoint name="ball_joint"/>
            <geom name="ball_geom" type="sphere" size="0.015" mass="0.03" material="ball_material" friction="0.5 0.05 0.001"/>
        </body>

        <!-- ── WALL obstacle (a HEAVY free body) between the objects and the bin ──
             Long + tall so the route is up-and-over. Judged by DISPLACEMENT, not touch:
             a sub-mm fingertip graze leaves it put (high mass + friction), but a real
             push moves it off its rest pose -> that is the collision fail. -->
        <body name="wall" pos="0.20 0.10 0.08">
            <freejoint name="wall_joint"/>
            <geom name="wall_geom" type="box" size="0.075 0.015 0.08" mass="3.0" material="wall_material" friction="1.0 0.05 0.001"/>
        </body>

        <!-- ── Container (blue bin), open top ── -->
        <body name="container" pos="0.20 0.21 0.0" quat="1 0 0 0">
            <freejoint name="container_joint"/>
            <geom name="container_bottom" type="box" size="0.08 0.08 0.01" pos="0 0 0.01" material="container_material" friction="0.3"/>
            <geom name="container_front"  type="box" size="0.08 0.01 0.06" pos="0 -0.08 0.06" material="container_material" friction="0.3"/>
            <geom name="container_back"   type="box" size="0.08 0.01 0.06" pos="0 0.08 0.06" material="container_material" friction="0.3"/>
            <geom name="container_left"   type="box" size="0.01 0.08 0.06" pos="-0.08 0 0.06" material="container_material" friction="0.3"/>
            <geom name="container_right"  type="box" size="0.01 0.08 0.06" pos="0.08 0 0.06" material="container_material" friction="0.3"/>
            <site name="container_center" pos="0 0 0.05" size="0.01"/>
        </body>
    </worldbody>

    <sensor>
        <framepos name="cube_pos" objtype="body" objname="cube" />
        <framepos name="container_pos" objtype="body" objname="container" />
        <framepos name="gripper_pos" objtype="site" objname="gripperframe" />
        <framepos name="grasp_pos" objtype="site" objname="graspframe" />
    </sensor>
</mujoco>
