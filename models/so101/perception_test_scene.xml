<mujoco model="perception_test_scene">
    <include file="so101_new_calib.xml" />

    <option timestep="0.002" gravity="0 0 -9.81" noslip_iterations="3" impratio="10" cone="elliptic"/>

    <default>
        <geom solref="0.001 1" solimp="0.99 0.99 0.001"/>
    </default>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="90" elevation="-20" />
        <map znear="0.005" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
        <material name="red_material"       rgba="0.9 0.1 0.1 1" />   <!-- red cube -->
        <material name="blue_material"      rgba="0.1 0.3 0.9 1" />   <!-- blue tall box -->
        <material name="green_material"     rgba="0.1 0.8 0.2 1" />   <!-- green sphere -->
        <material name="yellow_material"    rgba="0.9 0.8 0.1 1" />   <!-- yellow cylinder -->
        <material name="container_material" rgba="0.75 0.75 0.78 1" /> <!-- grey bin -->
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- Four objects, DISTINCT colours + DISTINCT heights. Positions are set by the
             export at run time; z here just rests each on the floor (z = half-height). -->

        <!-- red CUBE, 30mm (z_centre 0.015) -->
        <body name="red_cube" pos="0.20 -0.14 0.015">
            <freejoint name="cube_joint"/>
            <geom name="cube_geom" type="box" size="0.015 0.015 0.015" mass="0.03" material="red_material" friction="0.5 0.05 0.001"/>
        </body>

        <!-- blue TALL BOX, 30x30mm footprint x 70mm tall (z_centre 0.035) — same footprint as the cube, stands taller -->
        <body name="blue_tall" pos="0.28 -0.06 0.035">
            <freejoint name="blue_tall_joint"/>
            <geom name="blue_tall_geom" type="box" size="0.015 0.015 0.035" mass="0.05" material="blue_material" friction="0.5 0.05 0.001"/>
        </body>

        <!-- green SPHERE, 40mm diameter (z_centre 0.020) -->
        <body name="green_sphere" pos="0.24 -0.10 0.02">
            <freejoint name="green_sphere_joint"/>
            <geom name="green_sphere_geom" type="sphere" size="0.02" mass="0.03" material="green_material" friction="0.5 0.05 0.001"/>
        </body>

        <!-- yellow CYLINDER, 30mm diameter x 50mm tall (z_centre 0.025) -->
        <body name="yellow_cyl" pos="0.32 -0.02 0.025">
            <freejoint name="yellow_cyl_joint"/>
            <geom name="yellow_cyl_geom" type="cylinder" size="0.015 0.025" mass="0.035" material="yellow_material" friction="0.5 0.05 0.001"/>
        </body>

        <!-- grey CONTAINER (open-top bin) -->
        <body name="container" pos="0.14 -0.24 0.0" quat="1 0 0 0">
            <freejoint name="container_joint"/>
            <geom name="container_bottom" type="box" size="0.06 0.06 0.01" pos="0 0 0.01" material="container_material" friction="0.3"/>
            <geom name="container_front"  type="box" size="0.06 0.01 0.05" pos="0 -0.06 0.05" material="container_material" friction="0.3"/>
            <geom name="container_back"   type="box" size="0.06 0.01 0.05" pos="0 0.06 0.05" material="container_material" friction="0.3"/>
            <geom name="container_left"   type="box" size="0.01 0.06 0.05" pos="-0.06 0 0.05" material="container_material" friction="0.3"/>
            <geom name="container_right"  type="box" size="0.01 0.06 0.05" pos="0.06 0 0.05" material="container_material" friction="0.3"/>
            <site name="container_center" pos="0 0 0.04" size="0.01"/>
        </body>
    </worldbody>
</mujoco>
